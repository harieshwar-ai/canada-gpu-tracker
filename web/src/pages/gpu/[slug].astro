---
import Layout from "../../layouts/Layout.astro";
import PriceChart from "../../components/PriceChart.astro";
import {
  getAllGpus,
  getGpuBySlug,
  getListingsForGpu,
  getPriceHistoryForGpu,
  getStore,
} from "../../lib/store";
import { formatCad, formatShortDate } from "../../lib/format";

export function getStaticPaths() {
  return getAllGpus().map((gpu) => ({
    params: { slug: gpu.slug },
  }));
}

const { slug } = Astro.params;
const gpu = getGpuBySlug(slug!);
if (!gpu) {
  return Astro.redirect("/");
}

const store = getStore();
const listings = getListingsForGpu(gpu.slug);
const chartSeries = getPriceHistoryForGpu(gpu.slug);

const pageTitle = `${gpu.modelName} — Canada GPU Tracker`;
const pageDescription = `Canadian retailer prices and stock for ${gpu.modelName} (${gpu.vramGb} GB VRAM). Compare CAD pricing and placeholder price history.`;
---

<Layout title={pageTitle} description={pageDescription} ogType="article">
  {store.placeholder && (
    <div class="banner-placeholder" role="status">
      <strong>Placeholder data</strong> — listing URLs and prices are examples only.
    </div>
  )}

  <main class="main">
    <a href="/" class="back-link">← All GPUs</a>

    <section class="gpu-hero card">
      <h1>{gpu.modelName}</h1>
      <div class="meta-row">
        <span>{gpu.chip}</span>
        <span>{gpu.vramGb} GB VRAM</span>
        <span>MSRP {formatCad(gpu.msrpCad)}</span>
        <span>{gpu.series}</span>
      </div>
    </section>

    <h2 class="section-title">Price history</h2>
    <PriceChart series={chartSeries} />

    <h2 class="section-title">Retailer listings</h2>
    <div class="card table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Retailer</th>
            <th>Variant</th>
            <th>Price</th>
            <th>Updated</th>
            <th>Stock</th>
          </tr>
        </thead>
        <tbody>
          {listings.map(({ listing, retailer, latest }) => (
            <tr>
              <td>{retailer.name}</td>
              <td>
                {listing.brand}
                {listing.variantLabel ? ` · ${listing.variantLabel}` : ""}
              </td>
              <td>{latest ? formatCad(latest.priceCad) : "—"}</td>
              <td>{latest ? formatShortDate(latest.observedAt) : "—"}</td>
              <td>
                {latest?.inStock ? (
                  <span class="stock-yes">In stock</span>
                ) : (
                  <span class="stock-no">Out of stock</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="listing-note">
      Product links are disabled in placeholder mode (example.invalid URLs).
    </p>
  </main>
</Layout>

<style>
  .listing-note {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>