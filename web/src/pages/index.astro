---
import Layout from "../layouts/Layout.astro";
import { summarizeGpus, getStore } from "../lib/store";
import { formatCad } from "../lib/format";

const store = getStore();
const rows = summarizeGpus();
const pageTitle = "Canada GPU Tracker: NVIDIA GPU prices in CAD across Canadian retailers";
const pageDescription =
  "Compare NVIDIA GeForce GPU prices in Canadian dollars, stock status, and price history across Canadian retailers. Placeholder data during early development.";
---

<Layout title={pageTitle} description={pageDescription}>
  {store.placeholder && (
    <div class="banner-placeholder" role="status">
      <strong>Placeholder data</strong> — prices and stock shown here are fabricated examples
      only. No retailer sites are scraped in this build.
    </div>
  )}

  <main class="main">
    <div class="card">
      <div class="filters" id="home-filters">
        <label>
          Series
          <select id="filter-series" aria-label="Filter by GPU series">
            <option value="">All series</option>
            <option value="50-series">50-series</option>
            <option value="40-series">40-series</option>
          </select>
        </label>
        <label>
          <input type="checkbox" id="filter-instock" />
          In stock only
        </label>
      </div>

      <div class="table-wrap">
        <table class="data-table" id="gpu-table">
          <thead>
            <tr>
              <th>Model</th>
              <th>VRAM</th>
              <th>MSRP</th>
              <th>Lowest price</th>
              <th>Retailer</th>
              <th>Stock</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr
                data-series={row.gpu.series}
                data-instock={row.inStockAnywhere ? "1" : "0"}
                data-has-offer={row.lowestPriceCad !== null ? "1" : "0"}
              >
                <td>
                  <a href={`/gpu/${row.gpu.slug}/`}>{row.gpu.modelName}</a>
                </td>
                <td>{row.gpu.vramGb} GB</td>
                <td>{formatCad(row.gpu.msrpCad)}</td>
                <td>
                  {row.lowestPriceCad !== null
                    ? formatCad(row.lowestPriceCad)
                    : "—"}
                </td>
                <td>{row.lowestRetailerName ?? "—"}</td>
                <td>
                  {row.inStockAnywhere ? (
                    <span class="badge badge-in">In stock</span>
                  ) : (
                    <span class="badge badge-out">No stock</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script>
    const seriesSelect = document.getElementById("filter-series") as HTMLSelectElement;
    const inStockCheck = document.getElementById("filter-instock") as HTMLInputElement;
    const table = document.getElementById("gpu-table") as HTMLTableElement;

    function applyFilters() {
      const series = seriesSelect.value;
      const inStockOnly = inStockCheck.checked;
      for (const row of table.querySelectorAll("tbody tr")) {
        const el = row as HTMLTableRowElement;
        const matchSeries = !series || el.dataset.series === series;
        const matchStock =
          !inStockOnly ||
          (el.dataset.instock === "1" && el.dataset.hasOffer === "1");
        el.hidden = !(matchSeries && matchStock);
      }
    }

    seriesSelect?.addEventListener("change", applyFilters);
    inStockCheck?.addEventListener("change", applyFilters);
  </script>
</Layout>