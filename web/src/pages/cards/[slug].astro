---
import Layout from "../../layouts/Layout.astro";
import PlaceholderBanner from "../../components/PlaceholderBanner.astro";
import PriceChart from "../../components/PriceChart.astro";
import Sparkline from "../../components/ui/Sparkline.astro";
import {
  getAllCards,
  getCardBySlug,
  getGpuMap,
  getOffersForCard,
  getPriceHistoryForCard,
  getStore,
} from "../../lib/store";
import { buildCardRows } from "../../lib/catalog";
import { formatCad, formatCardSpec } from "../../lib/format";
import { gpuUrl } from "../../lib/routes";
import type { Offer } from "../../../../types/db";

export function getStaticPaths() {
  return getAllCards().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const card = getCardBySlug(slug!);
if (!card) return Astro.redirect("/404");

const gpu = getGpuMap().get(card.gpuId)!;
const offers = getOffersForCard(card.id);
const chart = getPriceHistoryForCard(card.id);
const taxes = getStore().provinceTaxes;
const row = buildCardRows().find((r) => r.card.id === card.id);
const specLine = formatCardSpec(card);
const isPlaceholder = (o: Offer) => o.isPlaceholder === true;

const pageTitle = `${card.brand} ${card.modelName} price & stock (CAD)`;
const pageDescription = `Canadian prices and store stock for ${card.brand} ${card.modelName}.`;
---

<Layout title={pageTitle} description={pageDescription} ogType="article">
  <main id="main" class="page-wrap card-detail">
    <PlaceholderBanner />
    <nav class="breadcrumbs muted small">
      <a href="/">Home</a> · <a href={gpuUrl(gpu.slug)}>{gpu.modelName}</a> · {card.modelName}
    </nav>
    <header class="panel card-header">
      <p class="eyebrow">{gpu.modelName}</p>
      <h1>{card.brand} {card.modelName}</h1>
      {specLine && <p class="mono small muted card-spec">{specLine}</p>}
      {row?.lowest != null ? (
        <p class="best-now">
          Best live price <strong>{formatCad(row.lowest)}</strong>
          {row.pctMsrp != null && (
            <span class="pct">
              ({row.pctMsrp > 0 ? "+" : ""}{row.pctMsrp}% vs MSRP)
            </span>
          )}
          {row.sparkline.length > 1 && <Sparkline prices={row.sparkline} />}
        </p>
      ) : (
        <p class="muted best-now">No live prices yet</p>
      )}
    </header>

    <h2 class="section-head"><span>Offers</span></h2>
    <div class="table-wrap panel offers-panel">
      <table class="data-table offers-table">
        <thead>
          <tr>
            <th>Retailer</th>
            <th>Location</th>
            <th>Condition</th>
            <th>Price</th>
            <th>Tax hint</th>
            <th>Stock</th>
          </tr>
        </thead>
        <tbody>
          {offers.map(({ offer, retailer, store: st, latest }) => {
            const tax = st
              ? taxes.find((t) => t.provinceCode === st.provinceCode)
              : taxes[0];
            const withTax =
              latest && tax ? latest.priceCad * (1 + tax.taxRate) : null;
            return (
              <tr>
                <td>
                  {retailer.name}
                  {isPlaceholder(offer) && (
                    <span class="example-pill">Example</span>
                  )}
                </td>
                <td>{st ? `${st.city}, ${st.provinceCode}` : "Online"}</td>
                <td>{offer.condition.replace("_", " ")}</td>
                <td>{latest ? formatCad(latest.priceCad) : "—"}</td>
                <td class="muted small">
                  {withTax && tax
                    ? `${formatCad(withTax)} ${tax.taxLabel}`
                    : "—"}
                </td>
                <td>{latest?.inStock ? "In stock" : "Out"}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <ul class="offer-cards">
        {offers.map(({ offer, retailer, store: st, latest }) => {
          const tax = st
            ? taxes.find((t) => t.provinceCode === st.provinceCode)
            : taxes[0];
          const withTax =
            latest && tax ? latest.priceCad * (1 + tax.taxRate) : null;
          return (
            <li class="offer-card">
              <div class="offer-card-head">
                <strong>{retailer.name}</strong>
                {isPlaceholder(offer) && (
                  <span class="example-pill">Example</span>
                )}
              </div>
              <p class="muted small">
                {st ? `${st.city}, ${st.provinceCode}` : "Online"} ·{" "}
                {offer.condition.replace("_", " ")}
              </p>
              <p class="offer-card-price">
                {latest ? formatCad(latest.priceCad) : "—"}
                <span class="muted small">
                  {latest?.inStock ? "In stock" : "Out"}
                </span>
              </p>
              {withTax && tax && (
                <p class="muted small">
                  {formatCad(withTax)} {tax.taxLabel}
                </p>
              )}
            </li>
          );
        })}
      </ul>
    </div>

    <h2 class="section-head"><span>Price history</span></h2>
    <PriceChart series={chart} />
  </main>
</Layout>

<style>
  .card-header {
    padding: 1rem;
  }
  .card-header h1 {
    margin: 0.15rem 0 0.5rem;
    overflow-wrap: anywhere;
    word-break: break-word;
    font-size: clamp(1.15rem, 4vw, 1.65rem);
    line-height: 1.25;
  }
  .best-now {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin: 0.75rem 0 0;
  }
  .eyebrow {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .offer-cards {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0.75rem;
    gap: 0.65rem;
  }
  .offer-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.75rem;
    background: var(--bg-elevated);
  }
  .offer-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .offer-card-price {
    margin: 0.35rem 0 0;
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-weight: 600;
  }
  .example-pill {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.08rem 0.35rem;
    border-radius: 999px;
    background: var(--pill);
    color: var(--dim);
    margin-left: 0.35rem;
    vertical-align: middle;
  }
  @media (max-width: 640px) {
    .offers-table {
      display: none;
    }
    .offer-cards {
      display: grid;
    }
    .offers-panel {
      overflow-x: hidden;
      max-width: 100%;
    }
  }
</style>