---
import Layout from "../../layouts/Layout.astro";
import PlaceholderBanner from "../../components/PlaceholderBanner.astro";
import { getFreshFinds } from "../../lib/store";
import { cardUrl } from "../../lib/routes";
const items = getFreshFinds("by_city");
---

<Layout title="In stock by city — Canada GPU Tracker" description="Shelf stock by Canadian city (placeholder).">
  <main id="main" class="page-wrap">
    <PlaceholderBanner />
    <h1>In stock by city</h1>
    <ul class="fresh-list panel" style="padding:0.75rem">
      {items.map((f) => (
        <li><a href={cardUrl(f.card.slug)}>{f.card.brand} {f.card.modelName}</a> · {f.city} · {f.retailer.name}</li>
      ))}
    </ul>
  </main>
</Layout>