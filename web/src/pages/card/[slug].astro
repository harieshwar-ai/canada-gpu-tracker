---
import Layout from "../../layouts/Layout.astro";
import PlaceholderBanner from "../../components/PlaceholderBanner.astro";
import PriceChart from "../../components/PriceChart.astro";
import {
  getAllCards,
  getCardBySlug,
  getGpuMap,
  getOffersForCard,
  getPriceHistoryForCard,
  getStore,
} from "../../lib/store";
import { formatCad, formatShortDate } from "../../lib/format";

export function getStaticPaths() {
  return getAllCards().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const card = getCardBySlug(slug!);
if (!card) return Astro.redirect("/");

const gpu = getGpuMap().get(card.gpuId)!;
const offers = getOffersForCard(card.id);
const chart = getPriceHistoryForCard(card.id);
const taxes = getStore().provinceTaxes;

const pageTitle = `${card.brand} ${card.modelName} — ${gpu.modelName}`;
const pageDescription = `Canadian prices and in-store stock for ${card.brand} ${card.modelName} (${gpu.modelName}), specs, history, and provincial tax estimates (placeholder).`;
---

<Layout title={pageTitle} description={pageDescription} ogType="article">
  <PlaceholderBanner />
  <main class="main">
    <a href={`/gpu/${gpu.slug}/`} class="back-link">← {gpu.modelName}</a>

    <section class="gpu-hero card">
      <h1>{card.brand} {card.modelName}</h1>
      <div class="meta-row">
        <span>{gpu.modelName}</span>
        <span>{card.vramGb} GB</span>
        <span>{card.lengthMm} mm</span>
        <span>{card.slotWidth} slots</span>
        <span>{card.cooling} fan</span>
        <span>{card.powerConnector}</span>
        <span>PSU {card.psuWatts}W rec.</span>
      </div>
    </section>

    <h2 class="section-h">Offers &amp; shelf stock</h2>
    <div class="table-wrap card">
      <table class="data-table">
        <thead>
          <tr>
            <th>Retailer</th>
            <th>Location</th>
            <th>Condition</th>
            <th>Price (CAD)</th>
            <th>Tax hint</th>
            <th>Updated</th>
            <th>Stock</th>
          </tr>
        </thead>
        <tbody>
          {offers.map(({ offer, retailer, store: st, latest }) => {
            const tax = st
              ? taxes.find((t) => t.provinceCode === st.provinceCode)
              : taxes.find((t) => t.provinceCode === "ON");
            const withTax =
              latest && tax
                ? latest.priceCad * (1 + tax.taxRate)
                : null;
            return (
              <tr>
                <td>{retailer.name}</td>
                <td>{st ? `${st.city}, ${st.provinceCode}` : "Online"}</td>
                <td>{offer.condition.replace("_", " ")}</td>
                <td>{latest ? formatCad(latest.priceCad) : "—"}</td>
                <td class="muted small">
                  {withTax && tax
                    ? `${formatCad(withTax)} ${tax.taxLabel}`
                    : "—"}
                </td>
                <td>{latest ? formatShortDate(latest.observedAt) : "—"}</td>
                <td>
                  {latest?.inStock ? (
                    <span class="stock-yes">In stock</span>
                  ) : (
                    <span class="stock-no">Out</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <h2 class="section-h">Price history</h2>
    <PriceChart series={chart} />

    <p class="muted small listing-note">
      URLs are example.invalid in placeholder mode. Alerts:{" "}
      <a href="/alerts/">set a target price</a> for this card.
    </p>
  </main>
</Layout>