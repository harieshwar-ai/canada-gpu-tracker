---
import Layout from "../../layouts/Layout.astro";
import PlaceholderBanner from "../../components/PlaceholderBanner.astro";
import { buildCardRows } from "../../lib/catalog";
import { cardUrl } from "../../lib/routes";

const rows = buildCardRows();
---

<Layout title="Finder — Canada GPU Tracker" description="Find a card that fits your case and PSU.">
  <PlaceholderBanner />
  <main id="main" class="page-wrap">
    <h1>Finder</h1>
    <form class="card toolbar" id="finder">
      <label>Max length (mm) <input name="len" type="number" value="330" /></label>
      <label>Connector
        <select name="conn"><option value="">Any</option><option>8-pin</option><option>12V-2x6</option></select>
      </label>
      <button type="submit" class="btn-primary">Search</button>
    </form>
    <ul id="finder-results" class="fresh-list panel" style="padding:0.75rem">
      {rows.slice(0, 8).map((r) => (
        <li data-len={r.card.lengthMm} data-conn={r.card.powerConnector}>
          <a href={cardUrl(r.card.slug)}>{r.card.brand} {r.card.modelName}</a>
          <span class="mono small">{r.card.lengthMm}mm · {r.card.powerConnector}</span>
        </li>
      ))}
    </ul>
  </main>
  <script>
    document.getElementById("finder")?.addEventListener("submit", (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const max = Number(fd.get("len"));
      const conn = String(fd.get("conn") || "");
      document.querySelectorAll("#finder-results li").forEach((li) => {
        const el = li as HTMLElement;
        const okLen = !max || Number(el.dataset.len) <= max;
        const okConn = !conn || el.dataset.conn === conn;
        el.hidden = !(okLen && okConn);
      });
    });
  </script>
</Layout>