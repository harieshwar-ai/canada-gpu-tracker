---
import { getSiteStats, getGeForce50Gpus, getAllGpus, getProGpus } from "../../lib/store";
import { gpuUrl } from "../../lib/routes";

const stats = getSiteStats();
const gpu50 = getGeForce50Gpus();
const gpu40 = getAllGpus().filter((g) => g.series === "40-series");
const pro = getProGpus();
const brands = ["ASUS", "MSI", "Gigabyte", "PNY", "ZOTAC", "NVIDIA", "Palit"];
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="topbar">
  <div class="topbar-inner topbar-row">
    <a href="/" class="brand"><span>Canada</span> GPU Tracker</a>
    <form class="search-wrap" action="/cards/" method="get" role="search">
      <span aria-hidden="true">⌕</span>
      <input type="search" name="q" placeholder="Search cards or GPUs" aria-label="Search" />
      <kbd>/</kbd>
    </form>
    <div class="topbar-actions">
      <a href="/preferences/" class="btn-ghost hide-sm">Preferences</a>
      <a href="/preferences/#location" class="btn-ghost location-chip hide-sm">📍 Postal</a>
      <button type="button" class="btn-ghost" id="theme-toggle" aria-label="Switch theme">Theme</button>
      <a href="/alerts/" class="btn-ghost hide-sm">Alerts</a>
      <button type="button" class="btn-ghost menu-btn" id="nav-open" aria-expanded="false" aria-controls="mobile-drawer">
        Menu
      </button>
    </div>
  </div>
  <nav class="main-nav" aria-label="Main">
    <div class="nav-inner nav-scroll desktop-only">
      <details class="nav-dd">
        <summary>GPUs</summary>
        <div class="dd-panel">
          <p class="dd-label">GeForce 50</p>
          {gpu50.map((g) => (
            <a href={gpuUrl(g.slug)}>{g.modelName.replace("GeForce ", "")}</a>
          ))}
          <p class="dd-label">GeForce 40</p>
          {gpu40.map((g) => (
            <a href={gpuUrl(g.slug)}>{g.modelName.replace("GeForce ", "")}</a>
          ))}
          <p class="dd-label">RTX PRO</p>
          {pro.map((g) => (
            <a href={gpuUrl(g.slug)}>{g.modelName}</a>
          ))}
          <a href="/gpus/series/geforce-50/">50 series hub</a>
          <a href="/gpus/series/geforce-40/">40 series hub</a>
          <a href="/gpus/series/rtx-pro/">RTX PRO hub</a>
          <a href="/gpus/">All GPUs</a>
        </div>
      </details>
      <details class="nav-dd">
        <summary>Brands</summary>
        <div class="dd-panel">
          {brands.map((b) => (
            <a href={`/brands/${b.toLowerCase()}/`}>{b}</a>
          ))}
        </div>
      </details>
      <a href="/cards/">All cards</a>
      <a href="/cards/?avail=stock">In stock now</a>
      <a href="/deals/">Deals</a>
      <a href="/finder/">Finder</a>
      <a href="/compare/">Compare</a>
      <a href="/stores/">Stores</a>
      <span class="nav-meta">
        Live prices · {stats.stores} stores · {stats.retailers} retailers
      </span>
    </div>
  </nav>
  <div id="mobile-drawer" class="mobile-drawer" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
    <div class="drawer-head">
      <strong>Menu</strong>
      <button type="button" class="btn-ghost" id="nav-close" aria-label="Close menu">Close</button>
    </div>
    <div class="drawer-body">
      <a href="/gpus/">GPUs</a>
      <a href="/gpus/series/geforce-50/">GeForce 50 series</a>
      <a href="/gpus/series/geforce-40/">GeForce 40 series</a>
      <a href="/cards/">All cards</a>
      <a href="/cards/?avail=stock">In stock now</a>
      <a href="/deals/">Deals</a>
      <a href="/open-box/">Open box</a>
      <a href="/near/">Near me</a>
      <a href="/finder/">Finder</a>
      <a href="/compare/">Compare</a>
      <a href="/stores/">Stores</a>
      <a href="/preferences/">Preferences</a>
      <a href="/alerts/">Alerts</a>
      <p class="dd-label">Brands</p>
      {brands.map((b) => (
        <a href={`/brands/${b.toLowerCase()}/`}>{b}</a>
      ))}
    </div>
  </div>
  <div class="drawer-backdrop" id="drawer-backdrop" hidden></div>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "light" ? "dark" : "light";
    if (next === "light") root.dataset.theme = "light";
    else delete root.dataset.theme;
    localStorage.setItem("cgt-theme", next);
  });
  const saved = localStorage.getItem("cgt-theme");
  if (saved === "light") document.documentElement.dataset.theme = "light";
  document.addEventListener("keydown", (e) => {
    if (e.key === "/" && !(e.target as HTMLElement).matches("input,textarea")) {
      e.preventDefault();
      const input = document.querySelector<HTMLInputElement>('.search-wrap input[name="q"]');
      input?.focus();
    }
  });
  const drawer = document.getElementById("mobile-drawer");
  const backdrop = document.getElementById("drawer-backdrop");
  const openBtn = document.getElementById("nav-open");
  const closeBtn = document.getElementById("nav-close");
  function setDrawer(open: boolean) {
    if (!drawer || !backdrop || !openBtn) return;
    drawer.hidden = !open;
    backdrop.hidden = !open;
    openBtn.setAttribute("aria-expanded", open ? "true" : "false");
    document.body.style.overflow = open ? "hidden" : "";
  }
  openBtn?.addEventListener("click", () => setDrawer(true));
  closeBtn?.addEventListener("click", () => setDrawer(false));
  backdrop?.addEventListener("click", () => setDrawer(false));
  drawer?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setDrawer(false)));
</script>

<style>
  .nav-dd {
    position: relative;
  }
  .nav-dd summary {
    list-style: none;
    cursor: pointer;
    white-space: nowrap;
    font-size: 0.88rem;
    color: var(--muted);
    padding: 0.5rem 0.65rem;
  }
  .nav-dd[open] summary {
    color: var(--text);
  }
  .dd-panel {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 50;
    min-width: 220px;
    max-height: 70vh;
    overflow: auto;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: var(--radius);
    padding: 0.5rem;
    display: grid;
    gap: 0.25rem;
  }
  .dd-panel a {
    font-size: 0.82rem;
    color: var(--text);
    padding: 0.25rem 0.35rem;
    border-radius: 4px;
  }
  .dd-panel a:hover {
    background: var(--surface-hover);
    text-decoration: none;
  }
  .dd-label {
    margin: 0.35rem 0 0.15rem;
    font-size: 0.68rem;
    text-transform: uppercase;
    color: var(--dim);
  }
  .menu-btn {
    display: inline-flex;
  }
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 80;
    width: min(88vw, 320px);
    height: 100vh;
    background: var(--bg-elevated);
    border-left: 1px solid var(--border);
    padding: 1rem;
    overflow: auto;
    box-shadow: -8px 0 24px rgba(0, 0, 0, 0.35);
  }
  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .drawer-body {
    display: grid;
    gap: 0.35rem;
  }
  .drawer-body a {
    padding: 0.45rem 0.35rem;
    border-radius: 6px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .drawer-body a:hover {
    background: var(--surface-hover);
  }
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgba(0, 0, 0, 0.55);
  }
  @media (min-width: 900px) {
    .menu-btn,
    .mobile-drawer,
    .drawer-backdrop {
      display: none !important;
    }
  }
  @media (max-width: 899px) {
    .desktop-only {
      display: none;
    }
    .hide-sm {
      display: none;
    }
    .topbar-actions {
      gap: 0.35rem;
    }
    .search-wrap {
      order: 3;
      flex-basis: 100%;
      max-width: none;
    }
  }
</style>