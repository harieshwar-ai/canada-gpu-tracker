---
import { getSiteStats } from "../../lib/store";

const stats = getSiteStats();
const contactEmail = "harieshwar.dev@gmail.com";
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <a href="/" class="brand"><span>Canada</span> GPU Tracker</a>
      <p>Live-style CAD prices and shelf stock across Canadian retailers — placeholder data in this build.</p>
      <dl class="stat-row">
        <div class="stat-tile">
          <dd>{stats.cardsTracked}</dd>
          <dt>Cards</dt>
        </div>
        <div class="stat-tile">
          <dd>{stats.stores}</dd>
          <dt>Stores</dt>
        </div>
        <div class="stat-tile">
          <dd>{stats.retailers}</dd>
          <dt>Retailers</dt>
        </div>
      </dl>
    </div>
    <div>
      <h2>Shop</h2>
      <ul class="footer-links">
        <li><a href="/cards/">All graphics cards</a></li>
        <li><a href="/cards/?avail=stock">In stock now</a></li>
        <li><a href="/deals/">Deals</a></li>
        <li><a href="/price-drops/">Price drops</a></li>
        <li><a href="/open-box/">Open box</a></li>
        <li><a href="/near/">In stock by city</a></li>
        <li><a href="/finder/">Finder</a></li>
        <li><a href="/compare/">Compare</a></li>
      </ul>
    </div>
    <div>
      <h2>Resources</h2>
      <ul class="footer-links">
        <li><a href="/preferences/">Shopping preferences</a></li>
        <li><a href="/alerts/">Alerts</a></li>
        <li><a href={`mailto:${contactEmail}`}>Contact</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-links a {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .site-footer h2 {
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }
</style>