---
import { getLaunchPriceGrid } from "../lib/store";
import { formatCad } from "../lib/format";
import { gpuUrl } from "../lib/routes";
import MsrpBar from "./ui/MsrpBar.astro";

const rows = getLaunchPriceGrid();
---

<section class="section">
  <h2 class="section-h">GeForce 50 vs launch price (CAD)</h2>
  <div class="launch-grid">
    {rows.map((row) => (
      <a href={gpuUrl(row.gpu.slug)} class="launch-card card">
        <h3>{row.gpu.modelName.replace("GeForce ", "")}</h3>
        <p class="launch-sub">
          {row.gpu.vramGb}GB · MSRP {formatCad(row.gpu.launchMsrpCad)}
        </p>
        <p class="launch-price">
          {row.storesInStock} {row.storesInStock === 1 ? "store" : "stores"}
        </p>
        <div class="launch-cad">
          {row.cheapestInStock != null ? (
            <>
              <span class="amt">{formatCad(row.cheapestInStock)}</span>
              {row.pctOverMsrp != null && (
                <span class={row.pctOverMsrp > 0 ? "over pct" : "under pct"}>
                  {row.pctOverMsrp > 0 ? `+${row.pctOverMsrp}%` : `${row.pctOverMsrp}%`}
                </span>
              )}
              <MsrpBar pct={row.pctOverMsrp} />
            </>
          ) : (
            <span class="muted">sold out</span>
          )}
        </div>
        <p class="launch-stock">
          {row.cardsInStock}/{row.cardsTotal} cards in stock
        </p>
      </a>
    ))}
  </div>
</section>