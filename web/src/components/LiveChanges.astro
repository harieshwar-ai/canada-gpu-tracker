---
import { getLiveActivity } from "../lib/store";
import { timeAgo } from "../lib/time";

const events = getLiveActivity(8);
---

<section class="panel live-changes">
  <div class="panel-head">
    <h2>Live changes</h2>
  </div>
  {events.length === 0 ? (
    <p class="muted small live-empty">No live ingested prices yet. Real retailer rows will show here after the next successful crawl.</p>
  ) : (
    <ul class="change-list">
      {events.map((ev) => (
        <li class="change-item">
          <a href={ev.href} class="change-link">
            <span class="change-title">{ev.kind === "first_seen" ? "First seen: " : ""}{ev.title}</span>
            <span class="change-meta muted small">{ev.detail}</span>
          </a>
          <span class="change-time muted small">{timeAgo(ev.occurredAt)}</span>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .change-list {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .change-item {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem;
    align-items: baseline;
    min-width: 0;
  }
  .change-link {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    color: var(--text);
    text-decoration: none;
    min-width: 0;
    flex: 1 1 auto;
    max-width: calc(100% - 4.5rem);
  }
  .change-link:hover .change-title {
    color: var(--accent);
  }
  .change-title {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .change-time {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 0.8rem;
  }
  .live-empty {
    margin: 0.5rem 0 0.15rem;
  }
</style>