---
import { getLiveChanges, getCardMap, getGpuMap } from "../lib/store";
import { formatCad } from "../lib/format";
import { timeAgo } from "../lib/time";

const events = getLiveChanges(8);
const cardMap = getCardMap();
const gpuMap = getGpuMap();
---

<section class="panel">
  <div class="panel-head">
    <h2>Live changes</h2>
  </div>
  <ul class="change-list">
    {events.map((ev) => {
      const card = cardMap.get(ev.cardId);
      const gpu = card ? gpuMap.get(card.gpuId) : undefined;
      let detail = "";
      if (ev.eventType === "price_drop" && ev.priceCad != null && ev.previousPriceCad != null) {
        const delta = ev.previousPriceCad - ev.priceCad;
        detail = `−${formatCad(delta)}`;
      } else if (ev.eventType === "in_stock") {
        detail = "In stock";
      } else {
        detail = "Sold out";
      }
      const place = ev.city ? ` · ${ev.city}` : "";
      return (
        <li class="change-item">
          <a href={card ? `/cards/${card.slug}/` : "#"}>
            <span class={`change-icon ${ev.eventType === "price_drop" ? "drop" : ev.eventType === "in_stock" ? "stock" : "out"}`}>
              {ev.eventType === "price_drop" ? "↓" : ev.eventType === "in_stock" ? "✓" : "×"}
            </span>
            <span>
              <span class="change-title">{gpu?.modelName.replace("GeForce ", "")} {card?.brand} {card?.modelName}</span>
              <span class="change-meta">
                {detail}
                {place} · {timeAgo(ev.occurredAt)}
              </span>
            </span>
            {ev.priceCad != null && <span class="change-price">{formatCad(ev.priceCad)}</span>}
          </a>
        </li>
      );
    })}
  </ul>
</section>